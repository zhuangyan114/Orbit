{
  "name": "ozone-for-vscode",
  "displayName": "Ozone for VS Code",
  "description": "Modern STM32 debugging frontend powered by SEGGER Ozone with AI integration",
  "version": "0.4.9",
  "publisher": "ozone-debug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozone-debug/ozone-for-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "stm32",
    "arm",
    "cortex-m",
    "j-link",
    "ozone",
    "segger",
    "embedded",
    "debug"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:ozoneTimeline",
    "onView:ozoneWatch",
    "onDebugResolve:ozone"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ozone.debug",
        "title": "Ozone: Connect Target"
      },
      {
        "command": "ozone.addWatch",
        "title": "Ozone: Add to Watch",
        "icon": "$(add)"
      },
      {
        "command": "ozone.removeWatch",
        "title": "Ozone: Remove from Watch",
        "icon": "$(trash)"
      },
      {
        "command": "ozone.openTimeline",
        "title": "Ozone: Open Timeline",
        "icon": "$(graph)"
      },
      {
        "command": "ozone.addToDataSampling",
        "title": "Ozone: Add to Data Sampling",
        "icon": "$(graph)"
      },
      {
        "command": "ozone.openSettings",
        "title": "Ozone: Settings"
      },
      {
        "command": "ozone.enableMcuDebugViews",
        "title": "Ozone: Enable MCU Debug Views Integration"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ozone.addWatch",
          "when": "view == ozoneWatch",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ozone.removeWatch",
          "when": "view == ozoneWatch && viewItem == watchItem",
          "group": "inline"
        },
        {
          "command": "ozone.addToDataSampling",
          "when": "view == ozoneWatch && viewItem == watchItem",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "ozone-watch-panel",
          "title": "WATCH",
          "icon": "resources/icon.svg"
        },
        {
          "id": "ozone-timeline-panel",
          "title": "TIMELINE",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ozone-watch-panel": [
        {
          "type": "webview",
          "id": "ozoneWatch",
          "name": "WATCH"
        }
      ],
      "ozone-timeline-panel": [
        {
          "type": "webview",
          "id": "ozoneTimeline",
          "name": "TIMELINE"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ozoneWatch",
        "contents": "点击标题栏 + 按钮添加变量\n运行时自动 5Hz 刷新 · 变化时高亮"
      }
    ],
    "debuggers": [
      {
        "type": "ozone",
        "label": "Ozone (J-Link)",
        "runtime": "node",
        "program": "./dist/debugadapter.js",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "device": {
                "type": "string",
                "description": "Target device name",
                "default": "STM32F407VG"
              },
              "deviceName": {
                "type": "string",
                "description": "Target device name alias used by external MCU debug views",
                "default": "STM32F407VG"
              },
              "program": {
                "type": "string",
                "description": "Path to ELF/AXF file (烧录文件)",
                "default": "${workspaceFolder}/build/Debug/frame.elf"
              },
              "svdFile": {
                "type": "string",
                "description": "Optional CMSIS-SVD file used by Peripheral Viewer",
                "default": ""
              },
              "svdPath": {
                "type": "string",
                "description": "Optional CMSIS-SVD file alias used by some Peripheral Viewer versions",
                "default": ""
              },
              "interface": {
                "type": "string",
                "description": "Debug interface (SWD or JTAG)",
                "enum": [
                  "SWD",
                  "JTAG"
                ],
                "default": "SWD"
              },
              "speedKHz": {
                "type": "number",
                "description": "Interface speed in kHz",
                "default": 4000
              },
              "rtos": {
                "type": "string",
                "description": "Optional RTOS name for RTOS Views, for example FreeRTOS",
                "default": ""
              },
              "rttLogEnabled": {
                "type": "boolean",
                "description": "Read SEGGER RTT output and show it in the VS Code Debug Console",
                "default": true
              },
              "rttBufferIndex": {
                "type": "number",
                "description": "SEGGER RTT up-buffer index to read",
                "default": 0
              },
              "rttPollIntervalMs": {
                "type": "number",
                "description": "RTT log polling interval in milliseconds",
                "default": 50,
                "minimum": 10,
                "maximum": 5000
              },
              "rttReadSize": {
                "type": "number",
                "description": "Maximum bytes to read from RTT on each poll",
                "default": 4096,
                "minimum": 64,
                "maximum": 65536
              },
              "rttControlBlockAddress": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Optional SEGGER RTT control block address, for example 0x20000000. Leave empty for J-Link auto-detection.",
                "default": ""
              },
              "rttStripAnsi": {
                "type": "boolean",
                "description": "Strip SEGGER/ANSI color control sequences before writing RTT logs to the Debug Console. The RTT terminal always preserves ANSI colors.",
                "default": true
              },
              "rttLogTarget": {
                "type": "string",
                "description": "Where RTT logs are shown",
                "enum": [
                  "terminal",
                  "debugConsole",
                  "both"
                ],
                "default": "terminal"
              },
              "pRtLogEnabled": {
                "type": "boolean",
                "description": "Decode P-RTLog tokenized RTT frames instead of treating RTT bytes as plain text",
                "default": false
              },
              "pRtLogRoot": {
                "type": "string",
                "description": "Path to the P-RTLog toolkit root",
                "default": "D:\\STM32\\tool\\P-RTLog"
              },
              "nativeDebugEngineEnabled": {
                "type": "boolean",
                "description": "Enable the experimental Native Debug Engine session path",
                "default": false
              },
              "nativeDebugEngineMode": {
                "type": "string",
                "enum": ["legacy", "native", "auto"],
                "description": "Select legacy koffi, explicit Native, or Native startup with legacy fallback",
                "default": "auto"
              },
              "nativeDebugEngineStepInto": {
                "type": "boolean",
                "description": "Use Native stepIntoInstruction when an exclusive native executor is connected",
                "default": false
              },
              "nativeDebugEngineStepOver": {
                "type": "boolean",
                "description": "Use Native stepOverSourceLine when an exclusive native executor is connected",
                "default": false
              },
              "nativeDebugEngineStepOut": {
                "type": "boolean",
                "description": "Use Native stepOut when an exclusive native executor is connected",
                "default": false
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Ozone Debug",
      "properties": {
        "ozone.jlinkPath": {
          "type": "string",
          "default": "C:\\Program Files\\SEGGER\\JLink\\JLink.exe",
          "description": "Path to J-Link Commander executable (fallback)"
        },
        "ozone.jlinkDllPath": {
          "type": "string",
          "default": "",
          "description": "Path to JLink_x64.dll (auto-detected if empty)"
        },
        "ozone.defaultDevice": {
          "type": "string",
          "default": "STM32F407VG",
          "description": "Default target device name"
        },
        "ozone.defaultInterface": {
          "type": "string",
          "default": "SWD",
          "enum": [
            "SWD",
            "JTAG"
          ],
          "description": "Default debug interface"
        },
        "ozone.defaultSpeed": {
          "type": "number",
          "default": 4000,
          "description": "Default interface speed (kHz)"
        },
        "ozone.defaultProgram": {
          "type": "string",
          "default": "",
          "description": "Default ELF/AXF file path (烧录文件, 留空则自动检测 build/ 目录)"
        },
        "ozone.defaultSvdFile": {
          "type": "string",
          "default": "",
          "description": "Default CMSIS-SVD file path for Peripheral Viewer"
        },
        "ozone.defaultRtos": {
          "type": "string",
          "default": "",
          "description": "Default RTOS name for RTOS Views, for example FreeRTOS"
        },
        "ozone.rtosViewsAutoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically focus and refresh MCU Debug RTOS Views after the first stack trace. Disabled by default because it adds debug-session overhead."
        },
        "ozone.rttLogEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Read SEGGER RTT output and show it in the VS Code Debug Console"
        },
        "ozone.rttBufferIndex": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 15,
          "description": "SEGGER RTT up-buffer index to read"
        },
        "ozone.rttPollIntervalMs": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 5000,
          "description": "RTT log polling interval in milliseconds"
        },
        "ozone.rttReadSize": {
          "type": "number",
          "default": 4096,
          "minimum": 64,
          "maximum": 65536,
          "description": "Maximum bytes to read from RTT on each poll"
        },
        "ozone.rttControlBlockAddress": {
          "type": "string",
          "default": "",
          "description": "Optional SEGGER RTT control block address, for example 0x20000000. Leave empty for J-Link auto-detection."
        },
        "ozone.rttStripAnsi": {
          "type": "boolean",
          "default": true,
          "description": "Strip SEGGER/ANSI color control sequences before writing RTT logs to the Debug Console. The RTT terminal always preserves ANSI colors."
        },
        "ozone.rttLogTarget": {
          "type": "string",
          "default": "terminal",
          "enum": [
            "terminal",
            "debugConsole",
            "both"
          ],
          "description": "Where RTT logs are shown"
        },
        "ozone.pRtLogEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Decode P-RTLog tokenized RTT frames instead of treating RTT bytes as plain text"
        },
        "ozone.pRtLogRoot": {
          "type": "string",
          "default": "D:\\STM32\\tool\\P-RTLog",
          "description": "Path to the P-RTLog toolkit root"
        },
        "ozone.nativeDebugEngine.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental Native Debug Engine. Keep disabled until the session owns a single native J-Link channel."
        },
        "ozone.nativeDebugEngine.mode": {
          "type": "string",
          "enum": ["legacy", "native", "auto"],
          "default": "auto",
          "description": "Target owner selection: legacy uses koffi only; native fails without fallback; auto may fall back only before Native connects."
        },
        "ozone.nativeDebugEngine.stepOver": {
          "type": "boolean",
          "default": false,
          "description": "Route step over to Native stepOverSourceLine when the Native Debug Engine is enabled and connected."
        },
        "ozone.nativeDebugEngine.stepInto": {
          "type": "boolean",
          "default": false,
          "description": "Route step into to Native stepIntoInstruction when the Native Debug Engine is enabled and connected."
        },
        "ozone.nativeDebugEngine.stepOut": {
          "type": "boolean",
          "default": false,
          "description": "Route step out to Native stepOut when the Native Debug Engine is enabled and connected."
        },
        "ozone.watchPollIntervalMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Watch polling interval in milliseconds when target is halted. When running, polling is automatically slowed. Default 500ms."
        },
        "ozone.timelineSampleIntervalMs": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.1,
          "maximum": 10000,
          "description": "Target Timeline data sampling interval in milliseconds. 0.2 ms targets 5 kHz; actual rate depends on target read latency and expression count."
        },
        "ozone.timelineSendIntervalMs": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "maximum": 10000,
          "description": "Timeline webview update interval in milliseconds. Sampling can run faster than UI updates."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:cpp-channel": "node scripts/cpp-channel-smoke.js",
    "test:cpp-channel:mock": "node scripts/cpp-channel-smoke.js --mock",
    "watch": "node esbuild.config.js --watch",
    "mcp": "node mcp/ozone-mcp-server.js",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run build && code --extensionDevelopmentPath=."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "koffi": "^3.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  }
}
