{
  "name": "ozone-for-vscode",
  "displayName": "Ozone for VS Code",
  "description": "Modern STM32 debugging frontend powered by SEGGER Ozone with AI integration",
  "version": "0.1.0",
  "publisher": "ozone-debug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozone-debug/ozone-for-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "stm32",
    "arm",
    "cortex-m",
    "j-link",
    "ozone",
    "segger",
    "embedded",
    "debug"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onView:ozoneTimeline",
    "onView:ozoneWatch"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ozone.debug",
        "title": "Ozone: Connect Target"
      },
      {
        "command": "ozone.addWatch",
        "title": "Ozone: Add to Watch",
        "icon": "$(add)"
      },
      {
        "command": "ozone.removeWatch",
        "title": "Ozone: Remove from Watch",
        "icon": "$(trash)"
      },
      {
        "command": "ozone.openTimeline",
        "title": "Ozone: Open Timeline",
        "icon": "$(graph)"
      },
      {
        "command": "ozone.addToDataSampling",
        "title": "Ozone: Add to Data Sampling",
        "icon": "$(graph)"
      },
      {
        "command": "ozone.openSettings",
        "title": "Ozone: Settings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ozone.addWatch",
          "when": "view == ozoneWatch",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ozone.removeWatch",
          "when": "view == ozoneWatch && viewItem == watchItem",
          "group": "inline"
        },
        {
          "command": "ozone.addToDataSampling",
          "when": "view == ozoneWatch && viewItem == watchItem",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "ozone-watch-panel",
          "title": "WATCH",
          "icon": "resources/icon.svg"
        },
        {
          "id": "ozone-timeline-panel",
          "title": "TIMELINE",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ozone-watch-panel": [
        {
          "type": "tree",
          "id": "ozoneWatch",
          "name": "WATCH"
        }
      ],
      "ozone-timeline-panel": [
        {
          "type": "webview",
          "id": "ozoneTimeline",
          "name": "TIMELINE"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ozoneWatch",
        "contents": "点击标题栏 + 按钮添加变量\n运行时自动 5Hz 刷新 · 变化时高亮"
      }
    ],
    "debuggers": [
      {
        "type": "ozone",
        "label": "Ozone (J-Link)",
        "runtime": "node",
        "program": "./dist/debugadapter.js",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to ELF file",
                "default": "${workspaceFolder}/build/Debug/frame.elf"
              },
              "device": {
                "type": "string",
                "description": "Target device name",
                "default": "STM32F407VG"
              },
              "interface": {
                "type": "string",
                "description": "Debug interface (SWD or JTAG)",
                "enum": ["SWD", "JTAG"],
                "default": "SWD"
              },
              "speedKHz": {
                "type": "number",
                "description": "Interface speed in kHz",
                "default": 4000
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Ozone Debug",
      "properties": {
        "ozone.jlinkPath": {
          "type": "string",
          "default": "C:\\Program Files\\SEGGER\\JLink\\JLink.exe",
          "description": "Path to J-Link Commander executable (fallback)"
        },
        "ozone.jlinkDllPath": {
          "type": "string",
          "default": "",
          "description": "Path to JLink_x64.dll (auto-detected if empty)"
        },
        "ozone.defaultDevice": {
          "type": "string",
          "default": "STM32F407VG",
          "description": "Default target device name"
        },
        "ozone.defaultInterface": {
          "type": "string",
          "default": "SWD",
          "enum": [
            "SWD",
            "JTAG"
          ],
          "description": "Default debug interface"
        },
        "ozone.defaultSpeed": {
          "type": "number",
          "default": 4000,
          "description": "Default interface speed (kHz)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run build && code --extensionDevelopmentPath=."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "koffi": "^3.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  }
}
