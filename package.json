{
  "name": "orbit-for-vscode",
  "displayName": "Orbit",
  "description": "Modern STM32 debugging frontend powered by SEGGER J-Link with AI integration",
  "version": "1.0.3",
  "publisher": "orbit-debug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuangyan114/Orbit"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "stm32",
    "arm",
    "cortex-m",
    "j-link",
    "orbit",
    "segger",
    "embedded",
    "debug"
  ],
  "icon": "resources/orbit-icon-256.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:ozoneTimeline",
    "onView:ozoneWatch",
    "onDebugResolve:ozone"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ozone.debug",
        "title": "Orbit: Connect Target"
      },
      {
        "command": "ozone.addWatch",
        "title": "Orbit: Add to Watch",
        "icon": "$(add)"
      },
      {
        "command": "ozone.removeWatch",
        "title": "Orbit: Remove from Watch",
        "icon": "$(trash)"
      },
      {
        "command": "ozone.openTimeline",
        "title": "Orbit: Open Timeline",
        "icon": "$(graph)"
      },
      {
        "command": "ozone.addToDataSampling",
        "title": "Orbit: Add to Data Sampling",
        "icon": "$(graph)"
      },
      {
        "command": "ozone.openSettings",
        "title": "Orbit: Settings"
      },
      {
        "command": "ozone.enableMcuDebugViews",
        "title": "Orbit: Enable MCU Debug Views Integration"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ozone.addWatch",
          "when": "view == ozoneWatch",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ozone.removeWatch",
          "when": "view == ozoneWatch && viewItem == watchItem",
          "group": "inline"
        },
        {
          "command": "ozone.addToDataSampling",
          "when": "view == ozoneWatch && viewItem == watchItem",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "ozone-watch-panel",
          "title": "WATCH",
          "icon": "resources/orbit-view.svg"
        },
        {
          "id": "ozone-timeline-panel",
          "title": "TIMELINE",
          "icon": "resources/orbit-view.svg"
        }
      ]
    },
    "views": {
      "ozone-watch-panel": [
        {
          "type": "webview",
          "id": "ozoneWatch",
          "name": "WATCH"
        }
      ],
      "ozone-timeline-panel": [
        {
          "type": "webview",
          "id": "ozoneTimeline",
          "name": "TIMELINE"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ozoneWatch",
        "contents": "点击标题栏 + 按钮添加变量\n运行时自动 5Hz 刷新 · 变化时高亮"
      }
    ],
    "debuggers": [
      {
        "type": "ozone",
        "label": "Orbit (J-Link)",
        "runtime": "node",
        "program": "./dist/debugadapter.js",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "device": {
                "type": "string",
                "description": "Target device name",
                "default": "STM32F407VG"
              },
              "deviceName": {
                "type": "string",
                "description": "Target device name alias used by external MCU debug views",
                "default": "STM32F407VG"
              },
              "program": {
                "type": "string",
                "description": "Path to ELF/AXF file (烧录文件)",
                "default": "${workspaceFolder}/build/Debug/frame.elf"
              },
              "svdFile": {
                "type": "string",
                "description": "Optional CMSIS-SVD file used by Peripheral Viewer",
                "default": ""
              },
              "svdPath": {
                "type": "string",
                "description": "Optional CMSIS-SVD file alias used by some Peripheral Viewer versions",
                "default": ""
              },
              "interface": {
                "type": "string",
                "description": "Debug interface (SWD or JTAG)",
                "enum": [
                  "SWD",
                  "JTAG"
                ],
                "default": "SWD"
              },
              "speedKHz": {
                "type": "number",
                "description": "Interface speed in kHz",
                "default": 4000
              },
              "rtos": {
                "type": "string",
                "description": "Optional RTOS name for RTOS Views, for example FreeRTOS",
                "default": ""
              },
              "rttLogEnabled": {
                "type": "boolean",
                "description": "Read SEGGER RTT output and show it in the VS Code Debug Console",
                "default": true
              },
              "rttTimelineEnabled": {
                "type": "boolean",
                "description": "Enable the experimental RTTB Timeline sample consumer",
                "default": false
              },
              "rttTimelineChannelIndex": {
                "type": "number",
                "description": "SEGGER RTT up-buffer index carrying RTTB Timeline samples",
                "default": 1,
                "minimum": 0,
                "maximum": 15
              },
              "loggingEnabled": {
                "type": "boolean",
                "description": "Enable Orbit internal diagnostic logs (step, eval, DLL, and DAP)",
                "default": true
              },
              "clearLogsOnStart": {
                "type": "boolean",
                "description": "Clear Orbit internal diagnostic logs when the extension or debug session starts",
                "default": true
              },
              "rttBufferIndex": {
                "type": "number",
                "description": "SEGGER RTT up-buffer index to read",
                "default": 0
              },
              "rttPollIntervalMs": {
                "type": "number",
                "description": "RTT log polling interval in milliseconds",
                "default": 50,
                "minimum": 10,
                "maximum": 5000
              },
              "rttReadSize": {
                "type": "number",
                "description": "Maximum bytes to read from RTT on each poll",
                "default": 4096,
                "minimum": 64,
                "maximum": 65536
              },
              "rttControlBlockAddress": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Optional SEGGER RTT control block address, for example 0x20000000. Leave empty for J-Link auto-detection.",
                "default": ""
              },
              "rttStripAnsi": {
                "type": "boolean",
                "description": "Strip SEGGER/ANSI color control sequences before writing RTT logs to the Debug Console. The RTT terminal always preserves ANSI colors.",
                "default": true
              },
              "rttLogTarget": {
                "type": "string",
                "description": "Where RTT logs are shown",
                "enum": [
                  "terminal",
                  "debugConsole",
                  "both"
                ],
                "default": "terminal"
              },
              "pRtLogEnabled": {
                "type": "boolean",
                "description": "Decode P-RTLog tokenized RTT frames instead of treating RTT bytes as plain text",
                "default": false
              },
              "pRtLogRoot": {
                "type": "string",
                "description": "Path to the P-RTLog toolkit root",
                "default": ""
              },
              "nativeDebugEngineEnabled": {
                "type": "boolean",
                "description": "Prefer the Native helper session path and fall back to legacy only when startup fails",
                "default": true
              },
              "nativeDebugEngineMode": {
                "type": "string",
                "enum": [
                  "legacy",
                  "native",
                  "auto"
                ],
                "description": "Select legacy koffi, explicit Native, or Native startup with legacy fallback; an already connected Native owner never hot-switches",
                "default": "auto"
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Orbit Debug",
      "properties": {
        "orbit.jlinkPath": {
          "type": "string",
          "default": "C:\\Program Files\\SEGGER\\JLink\\JLink.exe",
          "description": "用于固件烧录流程的 J-Link Commander 可执行文件路径"
        },
        "orbit.jlinkDllPath": {
          "type": "string",
          "default": "",
          "description": "JLink_x64.dll 的路径（留空则自动检测）"
        },
        "orbit.defaultDevice": {
          "type": "string",
          "default": "STM32F407VG",
          "description": "默认目标设备名称"
        },
        "orbit.defaultInterface": {
          "type": "string",
          "default": "SWD",
          "enum": [
            "SWD",
            "JTAG"
          ],
          "description": "默认调试接口"
        },
        "orbit.defaultSpeed": {
          "type": "number",
          "default": 4000,
          "description": "默认接口速度（kHz）"
        },
        "orbit.defaultProgram": {
          "type": "string",
          "default": "",
          "description": "默认 ELF/AXF 文件路径（烧录文件，留空则自动检测 build/ 目录）"
        },
        "orbit.defaultSvdFile": {
          "type": "string",
          "default": "",
          "description": "用于外设查看器的默认 CMSIS-SVD 文件路径"
        },
        "orbit.defaultRtos": {
          "type": "string",
          "default": "",
          "description": "RTOS Views 使用的默认 RTOS 名称，例如 FreeRTOS"
        },
        "orbit.rtosViewsAutoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "首次获取调用栈后，自动聚焦并刷新 MCU Debug RTOS Views。默认关闭，因为会增加调试会话开销。"
        },
        "orbit.rttLogEnabled": {
          "type": "boolean",
          "default": true,
          "description": "读取 SEGGER RTT 输出，并将其显示在 VS Code 调试控制台中"
        },
        "orbit.rttTimelineEnabled": {
          "type": "boolean",
          "default": false,
          "description": "启用实验性的 RTTB Timeline Sample 消费者；需要 launch 中同时启用 RTT Timeline"
        },
        "orbit.rttTimelineChannelIndex": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 15,
          "description": "RTTB Timeline Sample 使用的 SEGGER RTT 上行缓冲区索引"
        },
        "orbit.logging.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Orbit 内部诊断日志（step、eval、DLL 和 DAP）。"
        },
        "orbit.logging.clearOnStart": {
          "type": "boolean",
          "default": true,
          "description": "扩展或调试会话启动时清空 Orbit 内部诊断日志。"
        },
        "orbit.rttBufferIndex": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 15,
          "description": "要读取的 SEGGER RTT 上行缓冲区索引"
        },
        "orbit.rttPollIntervalMs": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 5000,
          "description": "RTT 日志轮询间隔（毫秒）"
        },
        "orbit.rttReadSize": {
          "type": "number",
          "default": 4096,
          "minimum": 64,
          "maximum": 65536,
          "description": "每次轮询最多读取的 RTT 字节数"
        },
        "orbit.rttControlBlockAddress": {
          "type": "string",
          "default": "",
          "description": "可选的 SEGGER RTT 控制块地址，例如 0x20000000。留空则由 J-Link 自动检测。"
        },
        "orbit.rttStripAnsi": {
          "type": "boolean",
          "default": true,
          "description": "写入 RTT 日志到调试控制台前，移除 SEGGER/ANSI 颜色控制序列。RTT 终端始终保留 ANSI 颜色。"
        },
        "orbit.rttLogTarget": {
          "type": "string",
          "default": "terminal",
          "enum": [
            "terminal",
            "debugConsole",
            "both"
          ],
          "description": "RTT 日志显示位置"
        },
        "orbit.pRtLogEnabled": {
          "type": "boolean",
          "default": false,
          "description": "解码 P-RTLog 令牌化 RTT 帧，而不是将 RTT 字节作为纯文本处理"
        },
        "orbit.pRtLogRoot": {
          "type": "string",
          "default": "",
          "description": "P-RTLog 工具包根目录路径"
        },
        "orbit.nativeDebugEngine.enabled": {
          "type": "boolean",
          "default": true,
          "description": "优先使用 Native Helper 会话路径，仅在启动失败时回退到 Legacy。"
        },
        "orbit.nativeDebugEngine.mode": {
          "type": "string",
          "enum": [
            "legacy",
            "native",
            "auto"
          ],
          "default": "auto",
          "description": "目标所有者选择：legacy 仅使用 koffi；native 失败时不回退；auto 仅在 Native 连接前启动失败时回退。"
        },
        "orbit.watchPollIntervalMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 10000,
          "description": "目标暂停时 Watch 的轮询间隔（毫秒）。目标运行时会自动降低轮询频率。默认 500 毫秒。"
        },
        "orbit.timelineSampleIntervalMs": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.1,
          "maximum": 10000,
          "description": "Timeline 目标数据采样间隔（毫秒）。0.2 毫秒对应目标 5 kHz；实际速率取决于目标读取延迟和表达式数量。"
        },
        "orbit.timelineDataSource": {
          "type": "string",
          "enum": [
            "dap",
            "rtt",
            "mixed"
          ],
          "default": "dap",
          "description": "Timeline 数据源；rtt 仅消费显式 RTTB 信号表达式 rttb.payload[N]"
        },
        "orbit.flashBeforeDebug": {
          "type": "boolean",
          "default": true,
          "description": "启动调试前烧录当前 ELF/AXF 文件"
        },
        "orbit.recentSessions": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "description": "保留的最近调试会话数量"
        },
        "orbit.timelineSendIntervalMs": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "maximum": 10000,
          "description": "Timeline Webview 更新间隔（毫秒）。采样可以快于 UI 更新。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:cpp-channel": "node scripts/cpp-channel-smoke.js",
    "test:cpp-channel:mock": "node scripts/cpp-channel-smoke.js --mock",
    "watch": "node esbuild.config.js --watch",
    "mcp": "node Releases/mcp/orbit-mcp-server.js",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run build && code --extensionDevelopmentPath=."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "koffi": "^3.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  }
}
